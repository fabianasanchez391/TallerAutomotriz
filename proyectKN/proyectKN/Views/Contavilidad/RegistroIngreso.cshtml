@model proyectKN.Models.Ingreso

@{
    ViewData["Title"] = "Registro de Ingresos";
    Layout = "_Layout";
}

<link href="~/css/ingreso.css" rel="stylesheet" />

<div class="ingresos-container">

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger text-center">
            @ViewBag.Mensaje
        </div>
    }

    <div class="ingresos-header">
        <div>
            <h1>Ingresos</h1>
            <p>Gestión de ingresos del sistema</p>
        </div>

        <button type="button"
                class="btn-nuevo-ingreso"
                onclick="document.getElementById('ventanaRegistroIngreso').style.display='flex'">
            <i class="fas fa-money-bill-trend-up"></i>
            Nuevo Ingreso
        </button>
    </div>
    <div class="busqueda-card">
        <div class="busqueda-box">
            <i class="fa-solid fa-magnifying-glass"> </i>
            <input type="text"
                   id="buscarIngreso"
                   placeholder="Buscar Ingreso...">
        </div>
    </div>
    <div id="ventanaRegistroIngreso" class="modal-ingreso">
        <div class="modal-contenido-ingreso">
            <h2>Registro de Ingreso</h2>

            <form asp-action="RegistroIngreso"
                  asp-controller="Contavilidad"
                  method="post"
                  id="formRegistroIngreso"
                  class="form-ingreso">

                <div>
                    <label>Descripción del Ingreso</label>
                    <input type="text"
                           asp-for="Descripcion"
                           placeholder="Descripción del ingreso"
                           required />
                </div>

                <div>
                    <label>Deuda</label>
                    <input type="number"
                           id="Saldo_Pendiente"
                           asp-for="Saldo_Pendiente"
                           placeholder="0.00"
                           step="0.01"
                           min="0"
                           required
                           oninput="validarIngreso()" />
                </div>

                <div>
                    <label>Monto</label>
                    <input type="number"
                           id="Monto"
                           asp-for="Monto"
                           placeholder="0.00"
                           step="0.01"
                           min="0"
                           required />
                </div>

               

                <div class="form-botones-ingreso">
                    <button type="submit" class="btn-guardar">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="document.getElementById('ventanaRegistroIngreso').style.display='none'">
                        Cancelar
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="tabla-card">
        <!-- MODAL EDITAR INGRESO -->
        <div id="ventanaEditarIngreso" class="modal-ingreso">
            <div class="modal-contenido-ingreso">

                <h2>Editar Ingreso</h2>

                <form asp-action="EditarIngreso"
                      asp-controller="Contavilidad"
                      method="post"
                      class="form-ingreso">

                    <input type="hidden" asp-for="Consecutivo" id="editConsecutivo" />

                    <div>
                        <label>Descripción</label>
                        <input type="text" asp-for="Descripcion" id="editDescripcion" class="form-control" readonly required>

                        </div>
                        <div>
                             
                            <label>Deuda(₡)</label>
                            <input type="number" id="editSaldo" asp-for="Saldo_Pendiente" class="form-control"  required>

                            </div>
                        <div>
                            <label>Monto</label>
                            <input type="number" id="editMonto" asp-for="Monto" class="form-control" required>

                            </div>
                            

                          

                                <div class="form-botones-ingreso">

                                    <button type="submit"
                                            class="btn-guardar">
                                        Guardar
                                    </button>

                                    <button type="button"
                                            class="btn-cancelar"
                                            onclick="document.getElementById('ventanaEditarIngreso').style.display='none'">

                                        Cancelar

                                    </button>

                                </div>

                            </form>

                        </div>
                    </div>
                    <div class="table-container">
                        <table id="tablaIngreso" class=" table tabla-paginada">

                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Monto</th>
                                <th>Deuda</th>
                                <th>Fecha de Registro</th>
                                <th>Estado</th>
                                <th class="col-acciones">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                                <tr id="sinResultadosIngreso" hidden>
                                    <td colspan="6" class="sin-resultados-tabla">
                                        No se encontraron resultados
                                    </td>
                                </tr>
                            @if (ViewBag.Ingreso != null && ViewBag.Ingreso.Count > 0)
                            {
                                foreach (var item in ViewBag.Ingreso)
                                {
                                    <tr>
                                        <td>@item.Descripcion</td>
                                        <td>₡@item.Monto</td>
                                        <td>₡@item.Saldo_Pendiente</td>
                                        <td>@item.Fecha</td>

                                        <td>
                                            <span class="badge @(item.Estado == "Pagado" ? "pagado" : "pendiente")">
                                                @item.Estado
                                            </span>
                                        </td>

                                        <td class="acciones">
                                            <button type="button"
                                                    class="icon editar"
                                                    onclick="abrirEditarIngreso(
                                                '@item.Consecutivo',
                                                '@item.Descripcion',
                                                '@item.Monto.ToString(System.Globalization.CultureInfo.InvariantCulture)',
                                                '@item.Saldo_Pendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)',
                                                '@item.Estado'
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        No hay ingresos registrados
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="paginacion"></div>
                </div>
            </div>
</div>
            <script src="~/js/paginacion.js"></script>
            <script src="~/js/contabilidad.js"></script>
            <script src="~/js/ingreso.js"></script>