@model proyectKN.Models.LoginRequest

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutExterno";
}
<a href="/" class="login-back">
    <i class="fa-solid fa-arrow-left"></i>
    Volver al inicio
</a>

<div class="login-header">
    <p class="login-header__label">Acceso privado</p>
    <h2>Iniciar sesión</h2>
    <p>Ingresa tus credenciales para entrar al sistema.</p>
</div>



@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger text-center">
        @ViewBag.Mensaje
    </div>
}

<form class="login-form"
      asp-controller="Home"
      asp-action="Login"
      method="post">

    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="correo">Correo electrónico</label>

        <div class="input-icon">
            <i class="fa-solid fa-envelope"></i>

            <input id="correo"
                   asp-for="Correo"
                   type="email"
                   autocomplete="username"
                   placeholder="correo@ejemplo.com"
                   required />
        </div>
    </div>

    <div class="form-group">
        <label for="password">Contraseña</label>

        <div class="input-icon input-password">
            <i class="fa-solid fa-lock"></i>

            <input id="password"
                   asp-for="Contrasenna"
                   type="password"
                   autocomplete="current-password"
                   placeholder="Tu contraseña"
                   required />

            <i class="fa-solid fa-eye"
               id="togglePassword"></i>
        </div>
    </div>

    <div class="login-options">

        <label class="remember">
            <input type="checkbox"
                   name="recordarme"
                   value="true" />
            <span>Recordarme</span>
        </label>

        <a class="forgot-link"
               asp-controller="Home"
               asp-action="RecuperarAcceso">
            ¿Olvidaste tu contraseña?
        </a>

    </div>

    <button class="login-button" type="submit">
        <span>Entrar</span>
        <i class="fa-solid fa-arrow-right-to-bracket"></i>
    </button>

</form>

@section Scripts {
    <script src="~/js/login.js"></script>
}

<script>
    history.replaceState(null, "", location.href);
    history.pushState(null, "", location.href);

    window.addEventListener("popstate", function () {
    history.pushState(null, "", location.href);
    });
</script>